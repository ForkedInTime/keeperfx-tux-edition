// Cloudflare deployment of the KeeperFX: Tux Edition lobby server.
// Deploy with `npm run deploy` after `npx wrangler login` (see README.md).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lobby",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-01",
	"durable_objects": {
		"bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
	// Only the server's own log lines (log() in src/index.ts: events, never an
	// address or a name). No request logs: those would carry who connected.
	"observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
